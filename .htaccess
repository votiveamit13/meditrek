# Enable rewrite engine
RewriteEngine On

# Serve .html files when URL doesn't include .html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^([a-zA-Z0-9_-]+)$ $1.html [L]

# Optional: redirect old .html URLs to clean URLs
RewriteCond %{THE_REQUEST} \s/([^.]+)\.html
RewriteRule ^ /%1 [R=301,L]
RewriteCond %{HTTP_HOST} ^meditrekapp\.com$ [OR]
RewriteCond %{HTTP_HOST} ^www\.meditrekapp\.com$
RewriteRule ^/?$ "https\:\/\/meditrekaccess\.com\/" [R=301,L]

